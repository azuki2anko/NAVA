<Window x:Class="RxV4A.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yamaha AV Manager" Height="690" Width="1120"
        MinHeight="620" MinWidth="980"
        Icon="Assets/YamahaAvManager.ico"
        Background="#0A0F18" Foreground="#F4F7FB"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing" StateChanged="Window_StateChanged">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#121A28" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#213049" />
        <SolidColorBrush x:Key="AccentBrush" Color="#65E6D1" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#8B9AB0" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="24" />
        </Style>

        <Style x:Key="SoftButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#DCE5F3" />
            <Setter Property="Background" Value="#182337" />
            <Setter Property="BorderBrush" Value="#2A3A54" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#22314A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#2A3D59" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DisplayButtonStyle" TargetType="Button" BasedOn="{StaticResource SoftButtonStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="16,12" />
        </Style>

        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Border x:Name="Track" Background="#263247" CornerRadius="17"
                                    BorderBrush="#35445D" BorderThickness="1" />
                            <Ellipse x:Name="Thumb" Width="26" Height="26" Fill="#D7E0EC"
                                     HorizontalAlignment="Left" Margin="4,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#2ECDB1" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="#65E6D1" />
                                <Setter TargetName="Thumb" Property="Fill" Value="#071713" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.35" />
                                <Setter TargetName="Thumb" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DrumListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="#111A29" />
            <Setter Property="Foreground" Value="#DCE5F3" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1C2B42" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#234A4A" />
                                <Setter Property="Foreground" Value="#7EF2DE" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="34,28,34,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="RX-V4A" FontSize="27" FontWeight="SemiBold" />
                <TextBlock Text="N E T W O R K   A V   C O N T R O L" FontSize="11"
                           Foreground="{StaticResource MutedTextBrush}" Margin="1,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource SoftButtonStyle}" Content="↻  更新" Margin="0,0,10,0"
                        Click="RefreshButton_Click" />
                <Button Style="{StaticResource SoftButtonStyle}" Content="⚙  設定"
                        Click="SettingsButton_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,26,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.72*" MinWidth="205" />
                <ColumnDefinition Width="1.18*" MinWidth="340" />
                <ColumnDefinition Width="1.10*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="P O W E R" FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock x:Name="PowerStateText" Text="STANDBY" FontSize="22"
                                   FontWeight="SemiBold" Margin="0,9,0,18" />
                        <CheckBox x:Name="PowerToggle" Style="{StaticResource ToggleSwitchStyle}"
                                  Click="PowerToggle_Click" />
                    </StackPanel>
                    <Border Grid.Row="1" Background="#243148" />
                    <StackPanel Grid.Row="2" VerticalAlignment="Center">
                        <TextBlock Text="M U T E" FontSize="10"
                                   Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock x:Name="MuteStateText" Text="OFF" FontSize="16"
                                   FontWeight="SemiBold" Margin="0,7,0,13" />
                        <CheckBox x:Name="MuteToggle" Style="{StaticResource ToggleSwitchStyle}"
                                  Width="54" Height="29" Click="MuteToggle_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="12,0">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="VolumeDial" Width="286" Height="286" Cursor="Hand"
                          MouseLeftButtonDown="VolumeDial_MouseLeftButtonDown"
                          MouseMove="VolumeDial_MouseMove"
                          MouseLeftButtonUp="VolumeDial_MouseLeftButtonUp"
                          MouseWheel="VolumeDial_MouseWheel">
                        <Ellipse Margin="15" Stroke="#243149" StrokeThickness="12" />
                        <Ellipse Margin="15" Stroke="#34425A" StrokeThickness="1"
                                 StrokeDashArray="1,8" />
                        <Path x:Name="VolumeArc" Stroke="{StaticResource AccentBrush}" StrokeThickness="12"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line x:Name="VolumeIndicatorLine" X1="143" Y1="19" X2="143" Y2="42"
                              Stroke="#E7FFF9" StrokeThickness="3" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                        <Border Width="196" Height="196" CornerRadius="98" Background="#0D1420"
                                BorderBrush="#1D2A40" BorderThickness="1">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="V O L U M E" FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="VolumeValueText" Text="—" FontSize="40"
                                           FontWeight="Light" Margin="0,5,0,0" HorizontalAlignment="Center" />
                                <TextBlock x:Name="VolumeUnitText" Text="dB" FontSize="12"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                        <Button x:Name="VolumeDownButton" Style="{StaticResource SoftButtonStyle}"
                                Content="−" FontSize="19" Width="48" Padding="0,5" Click="VolumeDownButton_Click" />
                        <TextBlock Text="スクロール / ドラッグ" Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="10" VerticalAlignment="Center" Margin="15,0" />
                        <Button x:Name="VolumeUpButton" Style="{StaticResource SoftButtonStyle}"
                                Content="＋" FontSize="17" Width="48" Padding="0,5" Click="VolumeUpButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="12,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="R E C E I V E R   D I S P L A Y" FontSize="10"
                                   Foreground="{StaticResource MutedTextBrush}" />
                        <Border Background="#0A111C" BorderBrush="#1D2B42" BorderThickness="1"
                                CornerRadius="12" Padding="16,13" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="ConnectionIndicator" Width="8" Height="8" Fill="#64748B"
                                         Margin="0,0,11,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="接続情報" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock x:Name="ConnectionText" Text="未接続" FontSize="15"
                                               FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="DeviceText" Text="—" FontSize="10"
                                               Foreground="#718096" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="ソース" FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,19,0,7" />
                    <Button Grid.Row="2" x:Name="SourceButton" Style="{StaticResource DisplayButtonStyle}"
                            Click="SourceButton_Click">
                        <Grid>
                            <TextBlock x:Name="SourceText" Text="—" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="⌄" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" />
                        </Grid>
                    </Button>
                    <Popup x:Name="SourcePopup" Placement="Bottom" PlacementTarget="{Binding ElementName=SourceButton}"
                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Width="270" MaxHeight="300" Background="#111A29" BorderBrush="#344662"
                                BorderThickness="1" CornerRadius="14" Padding="4" Margin="0,6,0,0">
                            <ListBox x:Name="SourceList" Style="{StaticResource DrumListStyle}"
                                     SelectionChanged="SourceList_SelectionChanged" />
                        </Border>
                    </Popup>

                    <StackPanel Grid.Row="3" Margin="0,18,0,0">
                        <TextBlock Text="音場" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,7" />
                        <Button x:Name="SoundFieldButton" Style="{StaticResource DisplayButtonStyle}"
                                Click="SoundFieldButton_Click">
                            <Grid>
                                <TextBlock x:Name="SoundFieldText" Text="—" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="⌄" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" />
                            </Grid>
                        </Button>
                        <Popup x:Name="SoundFieldPopup" Placement="Bottom"
                               PlacementTarget="{Binding ElementName=SoundFieldButton}"
                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Width="270" MaxHeight="300" Background="#111A29" BorderBrush="#344662"
                                    BorderThickness="1" CornerRadius="14" Padding="4" Margin="0,6,0,0">
                                <ListBox x:Name="SoundFieldList" Style="{StaticResource DrumListStyle}"
                                         SelectionChanged="SoundFieldList_SelectionChanged" />
                            </Border>
                        </Popup>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <TextBlock x:Name="StatusText" Text="アンプを検索しています…" FontSize="11"
                       Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
            <TextBlock Text="L O C A L   C O N T R O L  •  127.0.0.1:55274" FontSize="9"
                       Foreground="#526176" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
