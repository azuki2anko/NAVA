<Window x:Class="RxV4A.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="RX-V4A Manager" Height="650" Width="720"
        Icon="Assets/RxV4AManager.ico"
        MinHeight="580" MinWidth="650"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="RX-V4A Manager" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Capability駆動の安全な基本操作" Foreground="Gray" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="2" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="8" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="接続" FontWeight="SemiBold" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ConnectionText" Text="未接続" />
                <TextBlock Grid.Row="1" Text="機器" Margin="0,8,0,0" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DeviceText" Text="—" Margin="0,8,0,0" />
                <TextBlock Grid.Row="2" Text="電源" Margin="0,8,0,0" FontWeight="SemiBold" />
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="PowerText" Text="—" Margin="0,8,0,0" />
                <TextBlock Grid.Row="3" Text="入力 / 音量" Margin="0,8,0,0" FontWeight="SemiBold" />
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="PlaybackText" Text="—" Margin="0,8,0,0" />
                <TextBlock Grid.Row="4" Text="最終更新" Margin="0,8,0,0" FontWeight="SemiBold" />
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="UpdatedText" Text="—" Margin="0,8,0,0" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="4">
            <TextBlock x:Name="BlockerWarningText" Visibility="Collapsed" Foreground="#C62828"
                       FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10" />
            <UniformGrid Columns="2" Rows="1">
                <Button x:Name="PowerOnButton" Content="アンプ ON" Height="48" Margin="0,0,8,0"
                        Click="PowerOnButton_Click" />
                <Button x:Name="StandbyButton" Content="Standby" Height="48" Margin="8,0,0,0"
                        Click="StandbyButton_Click" />
            </UniformGrid>
            <Button Content="状態を更新" Width="120" Height="32" HorizontalAlignment="Right" Margin="0,10,0,0"
                    Click="RefreshButton_Click" />
        </StackPanel>

        <Border Grid.Row="6" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel>
                <TextBlock Text="接続先" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="空欄なら保存済み接続先、SSDP、Windows近隣キャッシュの順に探索します。IPアドレスまたはホスト名だけを指定できます。"
                           Foreground="Gray" Margin="0,4,0,10" TextWrapping="Wrap" />
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="探索するNIC" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" x:Name="DiscoveryNetworkInterfaceComboBox"
                              Height="30" DisplayMemberPath="Label" />
                </Grid>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="保存して接続" Width="120" Margin="12,0,0,0"
                            Click="SaveHostButton_Click" />
                    <TextBox x:Name="ManualHostTextBox" Height="30" VerticalContentAlignment="Center" />
                </DockPanel>
                <Separator Margin="0,16,0,12" />
                <TextBlock Text="プログラマブルキーボード" FontSize="16" FontWeight="SemiBold" />
                <TextBlock x:Name="HotkeyStatusText"
                           Text="グローバルホットキーを準備しています…"
                           Foreground="Gray" Margin="0,4,0,0" TextWrapping="Wrap" />
                <TextBlock Text="既定: Ctrl+Alt+F13=ON、Ctrl+Alt+F14=Standby。F15～F24は未割り当てです。"
                           Foreground="Gray" Margin="0,4,0,0" TextWrapping="Wrap" />
                <Button Content="詳細設定…" Width="110" Height="32" HorizontalAlignment="Right"
                        Margin="0,10,0,0" Click="OpenSettingsButton_Click" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="8" Text="ローカルAPI: http://127.0.0.1:55274/api/v1  ·  OpenAPI: /openapi/v1.json"
                   Foreground="Gray" HorizontalAlignment="Center" />
    </Grid>
</Window>
