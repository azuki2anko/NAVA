<Window x:Class="RxV4A.Desktop.MainWindow"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="NAVA — Network AV Amp Controller" Height="575" Width="920"
        MinHeight="520" MinWidth="860"
        Icon="Assets/NAVA.ico"
        Background="#0A0F18" Foreground="#F4F7FB"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        WindowStyle="None" ResizeMode="CanResize"
         WindowStartupLocation="CenterScreen"
         Closing="Window_Closing" StateChanged="Window_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="64" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#121A28" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#213049" />
        <SolidColorBrush x:Key="AccentBrush" Color="#65E6D1" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#8B9AB0" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="SoftButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#DCE5F3" />
            <Setter Property="Background" Value="#182337" />
            <Setter Property="BorderBrush" Value="#2A3A54" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#22314A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#2A3D59" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DisplayButtonStyle" TargetType="Button" BasedOn="{StaticResource SoftButtonStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="14,10" />
        </Style>

        <Style x:Key="TitleActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SoftButtonStyle}">
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Background" Value="#152033" />
            <Setter Property="BorderBrush" Value="#24344D" />
        </Style>

        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Foreground" Value="#AAB8CB" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TitleButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TitleButtonBorder" Property="Background" Value="#19263A" />
                                <Setter TargetName="TitleButtonBorder" Property="BorderBrush" Value="#2C3D57" />
                                <Setter Property="Foreground" Value="#F2F7FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TitleButtonBorder" Property="Background" Value="#263750" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D44258" />
                    <Setter Property="BorderBrush" Value="#EE6074" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToggleSwitchStyle" TargetType="Button">
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Track" Background="#263247" CornerRadius="17"
                                    BorderBrush="#35445D" BorderThickness="1" />
                            <Ellipse x:Name="Thumb" Width="26" Height="26" Fill="#D7E0EC"
                                     HorizontalAlignment="Left" Margin="4,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="On">
                                <Setter TargetName="Track" Property="Background" Value="#2ECDB1" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="#65E6D1" />
                                <Setter TargetName="Thumb" Property="Fill" Value="#071713" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.35" />
                                <Setter TargetName="Thumb" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DrumListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="#111A29" />
            <Setter Property="Foreground" Value="#DCE5F3" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1C2B42" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#234A4A" />
                                <Setter Property="Foreground" Value="#7EF2DE" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="#0D1521" BorderBrush="#1D2A3E" BorderThickness="0,0,0,1">
            <Grid Margin="20,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Source="Assets/NAVA.png" Width="36" Height="36" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="11,0,0,0">
                    <TextBlock Text="NAVA" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="N E T W O R K   A V   A M P   C O N T R O L L E R" FontSize="7"
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleActionButtonStyle}" Content="↻  更新" Margin="0,0,8,0"
                            Click="RefreshButton_Click" />
                    <Button Style="{StaticResource TitleActionButtonStyle}" Content="⚙  設定"
                            Click="SettingsButton_Click" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleBarButtonStyle}"
                            ToolTip="最小化" Click="MinimizeButton_Click">
                        <Path Width="11" Height="1" Stretch="Fill" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 0,0.5 L 11,0.5" />
                    </Button>
                    <Button Style="{StaticResource CloseButtonStyle}"
                            ToolTip="閉じる" Click="CloseButton_Click">
                        <Path Width="11" Height="11" Stretch="Fill" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 1,1 L 10,10 M 10,1 L 1,10" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20,14,20,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.62*" MinWidth="166" />
                <ColumnDefinition Width="1.08*" MinWidth="274" />
                <ColumnDefinition Width="1.0*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,3,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="P O W E R" FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock x:Name="PowerStateText" Text="STANDBY" FontSize="18"
                                   FontWeight="SemiBold" Margin="0,6,0,12" />
                        <Button x:Name="PowerToggle" Style="{StaticResource ToggleSwitchStyle}" Tag="Off"
                                PreviewMouseLeftButtonDown="PowerToggle_PreviewMouseLeftButtonDown" />
                    </StackPanel>
                    <Border Grid.Row="1" Background="#243148" />
                    <StackPanel Grid.Row="2" VerticalAlignment="Center">
                        <TextBlock Text="M U T E" FontSize="10"
                                   Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock x:Name="MuteStateText" Text="OFF" FontSize="15"
                                   FontWeight="SemiBold" Margin="0,5,0,9" />
                        <Button x:Name="MuteToggle" Style="{StaticResource ToggleSwitchStyle}" Tag="Off"
                                Width="54" Height="29"
                                PreviewMouseLeftButtonDown="MuteToggle_PreviewMouseLeftButtonDown" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="3,0,6,0">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="VolumeDial" Width="232" Height="232" Cursor="Hand"
                          MouseLeftButtonDown="VolumeDial_MouseLeftButtonDown"
                          MouseMove="VolumeDial_MouseMove"
                          MouseLeftButtonUp="VolumeDial_MouseLeftButtonUp"
                          MouseWheel="VolumeDial_MouseWheel">
                        <Ellipse Margin="12" Stroke="#243149" StrokeThickness="10" />
                        <Ellipse Margin="12" Stroke="#34425A" StrokeThickness="1"
                                 StrokeDashArray="1,8" />
                        <Path x:Name="VolumeArc" Stroke="{StaticResource AccentBrush}" StrokeThickness="10"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line x:Name="VolumeIndicatorLine" X1="116" Y1="15" X2="116" Y2="34"
                              Stroke="#E7FFF9" StrokeThickness="3" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                        <Border Width="160" Height="160" CornerRadius="80" Background="#0D1420"
                                BorderBrush="#1D2A40" BorderThickness="1">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="V O L U M E" FontSize="10"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="VolumeValueText" Text="—" FontSize="34"
                                           FontWeight="Light" Margin="0,3,0,0" HorizontalAlignment="Center" />
                                <TextBlock x:Name="VolumeUnitText" Text="LEVEL" FontSize="10"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="VolumeDbText" Text="— dB" FontSize="11"
                                           Foreground="#65E6D1" Margin="0,5,0,0"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button x:Name="VolumeDownButton" Style="{StaticResource SoftButtonStyle}"
                                Content="−" FontSize="18" Width="44" Padding="0,4"
                                PreviewMouseLeftButtonDown="VolumeDownButton_PreviewMouseLeftButtonDown" />
                        <TextBlock Text="スクロール / ドラッグ" Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="9" VerticalAlignment="Center" Margin="10,0" />
                        <Button x:Name="VolumeUpButton" Style="{StaticResource SoftButtonStyle}"
                                Content="＋" FontSize="16" Width="44" Padding="0,4"
                                PreviewMouseLeftButtonDown="VolumeUpButton_PreviewMouseLeftButtonDown" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="6,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="R E C E I V E R   D I S P L A Y" FontSize="9"
                                   Foreground="{StaticResource MutedTextBrush}" />
                        <Border Background="#0A111C" BorderBrush="#1D2B42" BorderThickness="1"
                                CornerRadius="10" Padding="12,10" Margin="0,9,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="ConnectionIndicator" Width="8" Height="8" Fill="#64748B"
                                         Margin="0,0,11,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="接続情報" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock x:Name="ConnectionText" Text="未接続" FontSize="15"
                                               FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="DeviceText" Text="—" FontSize="10"
                                               Foreground="#718096" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="ソース" FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,13,0,5" />
                    <Button Grid.Row="2" x:Name="SourceButton" Style="{StaticResource DisplayButtonStyle}"
                            Click="SourceButton_Click">
                        <Grid>
                            <TextBlock x:Name="SourceText" Text="—" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="⌄" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" />
                        </Grid>
                    </Button>
                    <Popup x:Name="SourcePopup" Placement="Bottom" PlacementTarget="{Binding ElementName=SourceButton}"
                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Width="230" MaxHeight="260" Background="#111A29" BorderBrush="#344662"
                                BorderThickness="1" CornerRadius="12" Padding="4" Margin="0,5,0,0">
                            <ListBox x:Name="SourceList" Style="{StaticResource DrumListStyle}"
                                     SelectionChanged="SourceList_SelectionChanged" />
                        </Border>
                    </Popup>

                    <StackPanel Grid.Row="3" Margin="0,12,0,0">
                        <TextBlock Text="音場" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5" />
                        <Button x:Name="SoundFieldButton" Style="{StaticResource DisplayButtonStyle}"
                                Click="SoundFieldButton_Click">
                            <Grid>
                                <TextBlock x:Name="SoundFieldText" Text="—" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="⌄" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" />
                            </Grid>
                        </Button>
                        <Popup x:Name="SoundFieldPopup" Placement="Bottom"
                               PlacementTarget="{Binding ElementName=SoundFieldButton}"
                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Width="230" MaxHeight="260" Background="#111A29" BorderBrush="#344662"
                                    BorderThickness="1" CornerRadius="12" Padding="4" Margin="0,5,0,0">
                                <ListBox x:Name="SoundFieldList" Style="{StaticResource DrumListStyle}"
                                         SelectionChanged="SoundFieldList_SelectionChanged" />
                            </Border>
                        </Popup>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="20,0,20,14">
            <TextBlock x:Name="StatusText" Text="アンプを検索しています…" FontSize="10"
                       Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
            <TextBlock Text="LOCAL  •  127.0.0.1:55274" FontSize="8"
                       Foreground="#526176" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
