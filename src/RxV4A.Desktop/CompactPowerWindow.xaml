<Window x:Class="RxV4A.Desktop.CompactPowerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NAVA — 電源"
        Width="120" Height="38"
        MinWidth="64" MinHeight="24"
        MaxWidth="480" MaxHeight="180"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Icon="Assets/NAVA.ico"
        Background="Transparent"
        Closing="Window_Closing"
        Loaded="Window_Loaded">
    <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1,0,1,1" CornerRadius="5">
        <Viewbox Margin="5" Stretch="Uniform">
            <Grid Height="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition x:Name="StateColumn" Width="0" />
                    <ColumnDefinition Width="2" />
                    <ColumnDefinition Width="58" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" x:Name="DragGrip" Background="Transparent" Cursor="SizeAll"
                        ToolTip="ドラッグして移動" MouseLeftButtonDown="DragGrip_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="1" Height="22" Background="#71717A" Margin="0,0,2,0" />
                        <Border Width="1" Height="22" Background="#71717A" Margin="0,0,2,0" />
                        <Border Width="1" Height="22" Background="#71717A" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" x:Name="PowerStatePanel" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Ellipse x:Name="StateIndicator" Width="7" Height="7"
                             Fill="#71717A" HorizontalAlignment="Center" />
                    <TextBlock x:Name="StateText" Text="接続中…" Foreground="White"
                               FontSize="6" TextAlignment="Center" Margin="0,1,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Button Grid.Column="3" x:Name="PowerToggleButton" Width="58" Height="24"
                        Tag="Off" FocusVisualStyle="{x:Null}" Cursor="Hand"
                        PreviewMouseLeftButtonDown="PowerToggleButton_PreviewMouseLeftButtonDown">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="SwitchTrack" Width="58" Height="24"
                                    CornerRadius="12" Background="#52525B"
                                    BorderBrush="#71717A" BorderThickness="1">
                                <Grid Margin="2">
                                    <Ellipse x:Name="SwitchThumb" Width="18" Height="18"
                                             HorizontalAlignment="Left" Fill="#FAFAFA">
                                        <Ellipse.Effect>
                                            <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.45" />
                                        </Ellipse.Effect>
                                    </Ellipse>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Tag" Value="On">
                                    <Setter TargetName="SwitchTrack" Property="Background" Value="#16A34A" />
                                    <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#22C55E" />
                                    <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="SwitchTrack" Property="Opacity" Value="0.92" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="SwitchTrack" Property="Opacity" Value="0.78" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="SwitchTrack" Property="Opacity" Value="0.42" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Viewbox>
    </Border>
</Window>
