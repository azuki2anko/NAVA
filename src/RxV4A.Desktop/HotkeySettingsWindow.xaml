<Window x:Class="RxV4A.Desktop.HotkeySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yamaha AV Manager 詳細設定" Height="620" Width="820"
        MinHeight="520" MinWidth="700" WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="保存" Width="100" Height="32" Margin="0,0,8,0" Click="SaveButton_Click" />
            <Button Content="閉じる" Width="100" Height="32" Click="CloseButton_Click" />
        </StackPanel>
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Ctrl / Alt / Shift と F13～F24だけをRegisterHotKeyで登録します。Windowsキーは使用しません。"
                           TextWrapping="Wrap" />
                <TextBlock Text="Action ID: power-on、power-standby、activity:&lt;登録ID&gt;、blocker:&lt;登録ID&gt;、action:&lt;登録ID&gt;"
                           Foreground="Gray" Margin="0,4,0,8" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="選択行へキーを押して登録" Padding="12,5" Click="CaptureGlobalButton_Click" />
                    <TextBlock x:Name="CaptureStatusText" Margin="12,6,0,0" Foreground="DarkOrange" />
                </StackPanel>
            </StackPanel>
            <DataGrid x:Name="GlobalHotkeysGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                      SelectionMode="Single" ItemsSource="{Binding GlobalHotkeys}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="キー" Binding="{Binding FunctionKey}" Width="90" />
                    <DataGridCheckBoxColumn Header="Ctrl" Binding="{Binding Ctrl}" Width="60" />
                    <DataGridCheckBoxColumn Header="Alt" Binding="{Binding Alt}" Width="60" />
                    <DataGridCheckBoxColumn Header="Shift" Binding="{Binding Shift}" Width="60" />
                    <DataGridTextColumn Header="Action ID（空欄=未割り当て）" Binding="{Binding ActionId}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </DockPanel>
</Window>
